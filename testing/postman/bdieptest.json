		{
			"name": "Networks - List",
			"item": [
				{
					"name": "GET All Networks",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Testing network list endpoint",
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Response has correct structure', function () {",
									"    const responseJson = pm.response.json();",
									"    pm.expect(responseJson).to.have.property('success', true);",
									"    pm.expect(responseJson).to.have.property('data');",
									"    pm.expect(responseJson).to.have.property('page');",
									"    pm.expect(responseJson).to.have.property('limit');",
									"    pm.expect(responseJson).to.have.property('total');",
									"});",
									"",
									"pm.test('Data is an array of strings', function () {",
									"    const data = pm.response.json().data;",
									"    pm.expect(data).to.be.an('array');",
									"    if (data.length > 0) {",
									"        pm.expect(data[0]).to.be.a('string');",
									"    }",
									"});",
									"",
									"pm.test('Contains expected networks', function () {",
									"    const data = pm.response.json().data;",
									"    const expectedNetworks = ['HBO', 'Netflix', 'NBC', 'CBS', 'ABC'];",
									"    const foundCount = expectedNetworks.filter(network => data.includes(network)).length;",
									"    pm.expect(foundCount).to.be.at.least(2, 'Should contain at least 2 expected networks');",
									"});",
									"",
									"pm.test('Pagination metadata is correct', function () {",
									"    const responseJson = pm.response.json();",
									"    pm.expect(responseJson.page).to.equal(1);",
									"    pm.expect(responseJson.limit).to.equal(50);",
									"    pm.expect(responseJson.total).to.be.a('number');",
									"    pm.expect(responseJson.total).to.be.at.least(1);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/networks",
							"host": [
								"{{base_url}}"
							],
